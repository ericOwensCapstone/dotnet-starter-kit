@code {



    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    public IEnumerable<Claim>? Claims { get; set; }
    private bool _showAuthPanel = false;
    private double _opacity = 1.0;
    private ElementReference authPanelElement;
    private string? _userName;

    private static bool _hasNotShownWelcomePanel = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        Claims = authState.User.Claims;
        //var tempClaims = Claims?.ToList();
        _userName = Claims?.FirstOrDefault(c => c.Type == "fullName")?.Value;
        Console.WriteLine($"Home.OnInitializedAsync: IsReturningFromAuthentication = {AuthFlowState.IsReturningFromAuthentication}");

        if (_hasNotShownWelcomePanel)
        {
            Console.WriteLine("Home: Setting _showAuthPanel = true");           
            _showAuthPanel = true;
            _opacity = 1.0;
            StateHasChanged();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Console.WriteLine($"Home.OnAfterRender: firstRender={firstRender}, _showAuthPanel={_showAuthPanel}");
        if (firstRender && _showAuthPanel && !AuthFlowState.IsReturningFromAuthentication)
        {
            Console.WriteLine("Home: First render, starting fade panel");
            // Start the fade animation
            _ = FadePanel();
        }
        // Check if we're coming from authentication flow
        if (AuthFlowState.IsReturningFromAuthentication)
        {
            AuthFlowState.ClearReturningFromAuthentication();
        }
    }

    private async Task FadePanel()
    {
        Console.WriteLine("FadePanel: Starting fade");
        // Fade from 1.0 to 0.0
        for (double opacity = 1.0; opacity >= 0; opacity -= 0.05)
        {
            //Console.WriteLine("FadePanel: Setting opacity to " + opacity);
            _opacity = opacity;
            StateHasChanged();
            await Task.Delay(100);
        }

        Console.WriteLine("FadePanel: Fade complete, hiding panel");
        _showAuthPanel = false;
        _hasNotShownWelcomePanel = false;
        StateHasChanged();
    }

}