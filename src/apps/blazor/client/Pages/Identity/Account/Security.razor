<MudCard Outlined>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText>Security Settings</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info">
            <MudText>
                Your account is managed through Azure Active Directory B2C. 
                To change your password or manage other security settings, please use the Azure B2C interface.
            </MudText>
        </MudAlert>
        <MudText Class="mt-4">
            For additional security options, please contact your system administrator.
        </MudText>
    </MudCardContent>
</MudCard>