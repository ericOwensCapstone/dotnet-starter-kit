@page "/invitations"

@inject IAuthenticationService Authentication

<PageHeader Title="User Invitations" Header="User Invitations" SubHeader="Manage user invitations for your tenants." />

<EntityTable @ref="EntityTable" TEntity="InvitationDto" TId="Guid" TRequest="CreateInvitationRequest" Context="@Context"
    @bind-SearchString="_searchString">
    <EditFormContent>
        <MudItem xs="12" md="6">
            <MudTextField T="string" For="@(() => context.Email)" @bind-Value="context.Email" Label="Email" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" For="@(() => context.DisplayName)" @bind-Value="context.DisplayName" Label="Display Name" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" For="@(() => context.FirstName)" @bind-Value="context.FirstName" Label="First Name" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" For="@(() => context.LastName)" @bind-Value="context.LastName" Label="Last Name" />
        </MudItem>
        @if (_isRootAdmin)
        {
            <MudItem xs="12" md="6">
                <MudAutocomplete T="TenantDetail" 
                                Value="SelectedTenant"
                                ValueChanged="@((TenantDetail tenant) => { SelectedTenant = tenant; context.TargetTenantId = tenant?.Id ?? string.Empty; })"
                                SearchFunc="SearchTenantsLegacy"
                                ToStringFunc="@(tenant => tenant?.Name ?? string.Empty)"
                                Label="Tenant"
                                Placeholder="Type to search tenants..."
                                MinCharacters="0"
                                ShowProgressIndicator="true"
                                ProgressIndicatorColor="Color.Primary"
                                MaxItems="null"
                                Clearable="true"
                                CoerceText="false"
                                CoerceValue="true">
                    <ItemTemplate Context="tenant">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <MudIcon Icon="@(tenant.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" 
                                    Color="@(tenant.IsActive ? Color.Success : Color.Error)" Size="Size.Small" />
                            <div>
                                <div style="font-weight: 500;">@tenant.Name</div>
                                <div style="font-size: 0.75rem; color: var(--mud-palette-text-secondary);">@tenant.Id</div>
                            </div>
                        </div>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <div style="padding: 8px; color: var(--mud-palette-text-secondary);">
                            <span>Type to search tenants...</span>
                        </div>
                    </NoItemsTemplate>
                </MudAutocomplete>
            </MudItem>
        }
        else
        {
            @* Tenant admin sees read-only field with their tenant *@
            <MudItem xs="12" md="6">
                <MudTextField T="string" For="@(() => context.TargetTenantId)" @bind-Value="context.TargetTenantId" 
                             Label="Target Tenant ID" ReadOnly="true" 
                             HelperText="Your tenant (read-only)" />
            </MudItem>
        }
        <MudItem xs="12" md="6">
            @if (_availableRoles.Any())
            {
                <MudSelect T="string" For="@(() => context.Role)" @bind-Value="context.Role" 
                          Label="Role" Placeholder="Select a role" 
                          AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                    @foreach (var role in _availableRoles)
                    {
                        <MudSelectItem T="string" Value="@role.Name">
                            @role.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField T="string" For="@(() => context.Role)" @bind-Value="context.Role" Label="Role" 
                             HelperText="Enter the role name manually" />
            }
        </MudItem>
    </EditFormContent>
    <ExtraActions>
        <MudMenuItem OnClick="@(() => ViewInvitationDetailsAsync(context.Id))">
            <MudIcon Icon="Icons.Material.Filled.Visibility" Size="Size.Small" />
            View Details
        </MudMenuItem>
        
        <MudMenuItem OnClick="@(() => CopyInvitationLinkAsync(context.Id))">
            <MudIcon Icon="Icons.Material.Filled.ContentCopy" Size="Size.Small" />
            Copy Invitation Link
        </MudMenuItem>
        
        @if (context.Status == InvitationStatus._0 || context.Status == InvitationStatus._5)
        {
            <MudMenuItem OnClick="@(() => ResendInvitationAsync(context.Id))">
                <MudIcon Icon="Icons.Material.Filled.Send" Size="Size.Small" />
                Resend Invitation
            </MudMenuItem>
        }
        
        @if (context.Status != InvitationStatus._2 && context.Status != InvitationStatus._4 && context.Status != InvitationStatus._3)
        {
            <MudMenuItem OnClick="@(() => ExtendInvitationAsync(context.Id))">
                <MudIcon Icon="Icons.Material.Filled.Schedule" Size="Size.Small" />
                Extend Expiration
            </MudMenuItem>
        }
        
        @if (context.Status != InvitationStatus._2 && context.Status != InvitationStatus._4)
        {
            <MudMenuItem Style="color:red!important" OnClick="@(() => CancelInvitationAsync(context.Id))">
                <MudIcon Icon="Icons.Material.Filled.Cancel" Size="Size.Small" />
                Cancel Invitation
            </MudMenuItem>
        }
    </ExtraActions>

</EntityTable>