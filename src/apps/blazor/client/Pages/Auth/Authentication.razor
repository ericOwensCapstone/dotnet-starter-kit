@page "/authentication/{action}"
@attribute [AllowAnonymous]
@using FSH.Starter.Blazor.Infrastructure.Auth
@using FSH.Starter.Blazor.Infrastructure.Auth.AzureB2C
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.AspNetCore.Authorization
@using Blazored.LocalStorage
@using FSH.Starter.Blazor.Infrastructure.Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider
@inject ILocalStorageService LocalStorage
@inject IApiClient ApiClient

@if (_isB2C && !_hasError)
{
    @* For B2C, show a clean loading state *@
    <style>
        .auth-processing-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--mud-palette-background);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 99999;
        }
    </style>
    <div class="auth-processing-container">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else if (!_isB2C || _hasError)
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        @if (_hasError)
                        {
                            <h4 class="text-danger">Authentication Error</h4>
                            <div class="alert alert-danger mt-3">
                                <i class="fas fa-exclamation-triangle"></i>
                                @_errorMessage
                            </div>
                            <button class="btn btn-primary mt-3" @onclick="RetryAuthentication">
                                Try Again
                            </button>
                        }
                        else
                        {
                            <h4>@GetTitle()</h4>
                            <div class="spinner-border text-primary mt-3" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3">@GetMessage()</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Action { get; set; } = string.Empty;
    [CascadingParameter] public Task<AuthenticationState> AuthState { get; set; } = default!;
    
    private bool _hasError = false;
    private string _errorMessage = string.Empty;
    private bool _isB2C = false;

    protected override async Task OnInitializedAsync()
    {
        var authConfig = ServiceProvider.GetService<IAuthenticationConfigurationService>();
        _isB2C = authConfig?.IsAzureB2C() == true;
        
        if (_isB2C)
        {
            if (Action == "login-callback")
            {
                // Handle B2C login callback immediately in OnInitializedAsync
                await HandleB2CCallback();
            }
            else if (Action == "logout-callback")
            {
                // Redirect to home after logout
                Navigation.NavigateTo("/");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only process non-B2C authentication here
        if (firstRender && !_isB2C)
        {
            // Handle non-B2C authentication if needed
        }
    }

    private async Task HandleB2CCallback()
    {
        try
        {
            // Get the B2C token from the URL fragment
            var uri = new Uri(Navigation.Uri);
            var fragment = await JS.InvokeAsync<string>("eval", "window.location.hash");
            
            if (!string.IsNullOrEmpty(fragment) && fragment.Length > 1)
            {
                var parameters = ParseFragment(fragment);
                
                string? token = null;
                if (parameters.TryGetValue("id_token", out var idToken))
                {
                    token = idToken;
                }
                else if (parameters.TryGetValue("access_token", out var accessToken))
                {
                    token = accessToken;
                }
                
                if (!string.IsNullOrEmpty(token))
                {
                    Console.WriteLine("Authentication.razor: Found B2C token in URL fragment");
                    // Exchange B2C token for local JWT
                    var b2cService = ServiceProvider.GetService<B2CAuthenticationService>();
                    if (b2cService != null)
                    {
                        var success = await b2cService.ExchangeB2CTokenAsync(token);
                        
                        if (success)
                        {
                            Console.WriteLine("Authentication.razor: Token exchange successful, verifying directly with B2C service");
                            
                            // Wait a moment for state propagation
                            await Task.Delay(100);
                            
                            // Verify directly with the B2C service instead of relying on cascading AuthState
                            var directAuthState = await b2cService.GetAuthenticationStateAsync();
                            if (directAuthState.User.Identity?.IsAuthenticated == true)
                            {
                                Console.WriteLine("Authentication.razor: Direct B2C auth state confirmed, checking for pending invitation");
                                
                                // Check if there's a pending invitation to accept
                                var pendingInvitationToken = await LocalStorage.GetItemAsync<string>("pendingInvitationToken");
                                if (!string.IsNullOrEmpty(pendingInvitationToken))
                                {
                                    Console.WriteLine("Authentication.razor: Found pending invitation token, clearing it");
                                    // Clear the pending invitation token
                                    // The invitation is automatically processed server-side when the B2C user is provisioned
                                    await LocalStorage.RemoveItemAsync("pendingInvitationToken");
                                }
                                
                                // Force the global authentication state to be updated
                                // by triggering the cascading authentication state to refresh
                                await Task.Delay(200); // Give more time for state propagation
                                
                                // Force a state refresh by causing a re-render
                                StateHasChanged();
                                await Task.Delay(100);
                                
                                Console.WriteLine("Authentication.razor: Navigating to home with force reload");
                                Navigation.NavigateTo("/", forceLoad: true);
                                return;
                            }
                            else
                            {
                                Console.WriteLine("Authentication.razor: Direct B2C auth state not authenticated yet, waiting longer");
                                await Task.Delay(500);
                                directAuthState = await b2cService.GetAuthenticationStateAsync();
                                if (directAuthState.User.Identity?.IsAuthenticated == true)
                                {
                                    Console.WriteLine("Authentication.razor: Direct B2C auth state confirmed after retry, forcing final state refresh");
                                    
                                    // Force final state refresh
                                    StateHasChanged();
                                    await Task.Delay(100);
                                    
                                    Console.WriteLine("Authentication.razor: Navigating to home with force reload (retry)");
                                    Navigation.NavigateTo("/", forceLoad: true);
                                    return;
                                }
                                else
                                {
                                    Console.WriteLine("Authentication.razor: Direct B2C auth state still not authenticated, showing error");
                                    ShowB2CError("Authentication completed but state not updated. Please try again.");
                                    return;
                                }
                            }
                        }
                        else
                        {
                            Console.WriteLine("Authentication.razor: Token exchange failed");
                        }
                    }
                }
                else
                {
                    Console.WriteLine("Authentication.razor: No B2C token found in URL fragment");
                    // No token in fragment, check if user is already authenticated
                    await CheckExistingAuthentication();
                }
            }
            else
            {
                Console.WriteLine("Authentication.razor: No URL fragment found");
                // No fragment at all, check if user is already authenticated
                await CheckExistingAuthentication();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Authentication.razor: Error in HandleB2CCallback: {ex.Message}");
            ShowB2CError("An error occurred during authentication. Please try again.");
        }
    }

    private async Task CheckExistingAuthentication()
    {
        // Check if the user is already authenticated
        var authState = await AuthState;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Console.WriteLine("Authentication.razor: User already authenticated, redirecting to home");
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            Console.WriteLine("Authentication.razor: No authentication found");
            ShowB2CError("Authentication failed. Please try again.");
        }
    }

    private Dictionary<string, string> ParseFragment(string fragment)
    {
        var result = new Dictionary<string, string>();
        
        if (fragment.StartsWith("#"))
            fragment = fragment.Substring(1);
            
        var pairs = fragment.Split('&');
        foreach (var pair in pairs)
        {
            var parts = pair.Split('=');
            if (parts.Length == 2)
            {
                result[parts[0]] = Uri.UnescapeDataString(parts[1]);
            }
        }
        
        return result;
    }

    private string GetTitle() => Action switch
    {
        "login-callback" => "Completing Sign In...",
        "logout-callback" => "Signing Out...",
        _ => "Processing..."
    };

    private string GetMessage() => Action switch
    {
        "login-callback" => "Please wait while we complete your sign in.",
        "logout-callback" => "You have been signed out successfully.",
        _ => "Please wait..."
    };

    private void ShowB2CError(string message)
    {
        _hasError = true;
        _errorMessage = message;
        StateHasChanged();
    }

    private void RetryAuthentication()
    {
        Navigation.NavigateTo("/login");
    }
}