@page "/ranch/growthTreatments"

<PageHeader Title="GrowthTreatments" Header="GrowthTreatments" SubHeader="Manage your GrowthTreatments." />

<EntityTable @ref="_table" TEntity="GrowthTreatmentResponse" TId="Guid" TRequest="GrowthTreatmentViewModel" Context="@Context">

    <AdvancedSearchContent>
        
    </AdvancedSearchContent>

    <EditFormContent>
        @if (!Context.AddEditModal.IsCreate)
        {
            <MudItem xs="12" md="6">
                <MudTextField Value="context.Id" Underline=false ReadOnly Label="GrowthTreatment Id" />
            </MudItem>
        }
        @* TODO START *@
        <MudItem xs="12" md="6">
            <MudTextField Label="Name" For="@(() => context.Name)" @bind-Value="context.Name" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField Label="Description" For="@(() => context.Description)" @bind-Value="context.Description" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField Label="DollarsPerHead" For="@(() => context.DollarsPerHead)" @bind-Value="context.DollarsPerHead" />
        </MudItem>
        @* TODO END *@
    </EditFormContent>

</EntityTable>