@layout EmptyLayout
@inject IServiceProvider ServiceProvider
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation
@inject AuthFlowStateService AuthFlowState
@using FSH.Starter.Blazor.Infrastructure.Auth
@using FSH.Starter.Blazor.Infrastructure.Api
@using FSH.Starter.Blazor.Client.Components.Common

<LoadingPanel Message="Please wait while we redirect you to sign in" IsVisible="true" />

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check if using B2C
            var authConfig = ServiceProvider.GetService<IAuthenticationConfigurationService>();
            if (authConfig?.IsAzureB2C() == true)
            {
                // Check for error to prevent redirect loops
                var uri = new Uri(Navigation.Uri);
                if (!uri.Query.Contains("error="))
                {
                    // Set auth flow state before redirecting to B2C
                    await AuthFlowState.SetStateAsync(FSH.Starter.Blazor.Infrastructure.Auth.AuthFlowState.RedirectingToB2C);
                    
                    // For B2C, navigate to external login (B2C)
                    AuthenticationService.NavigateToExternalLogin("/");
                    return;
                }
            }

            // For local auth or B2C errors, navigate to login page
            Navigation.NavigateTo("/login", forceLoad: false);
        }
        catch
        {
            // Silently handle any errors - just navigate to login
            Navigation.NavigateTo("/login", forceLoad: false);
        }
    }
}