@page "/ranch/lifecycleStages"

<PageHeader Title="LifecycleStages" Header="LifecycleStages" SubHeader="Manage your LifecycleStages." />

<EntityTable @ref="_table" TEntity="LifecycleStageResponse" TId="Guid" TRequest="LifecycleStageViewModel" Context="@Context">

    <AdvancedSearchContent>
        <MudSelect T="Guid?" Label="Ration" @bind-Value="SearchRationId">
            <MudSelectItem T="Guid?" Value="null">All Rations</MudSelectItem>
            @foreach (var ration in _rations)
            {
                <MudSelectItem T="Guid?" Value="ration.Id">@ration.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Guid?" Label="GrowthTreatment" @bind-Value="SearchGrowthTreatmentId">
            <MudSelectItem T="Guid?" Value="null">All GrowthTreatments</MudSelectItem>
            @foreach (var growthTreatment in _growthTreatments)
            {
                <MudSelectItem T="Guid?" Value="growthTreatment.Id">@growthTreatment.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Guid?" Label="PreventiveTreatment" @bind-Value="SearchPreventiveTreatmentId">
            <MudSelectItem T="Guid?" Value="null">All PreventiveTreatments</MudSelectItem>
            @foreach (var preventiveTreatment in _preventiveTreatments)
            {
                <MudSelectItem T="Guid?" Value="preventiveTreatment.Id">@preventiveTreatment.Name</MudSelectItem>
            }
        </MudSelect>
    </AdvancedSearchContent>

    <EditFormContent>
        @* TODO START *@
        <MudItem xs="12" md="6">
            <MudTextField Label="Name" For="@(() => context.Name)" @bind-Value="context.Name" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField Label="Description" For="@(() => context.Description)" @bind-Value="context.Description" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="Guid?" Label="Ration" @bind-Value="context.RationId">
                @foreach(var ration in _rations)
                {
                    <MudSelectItem T="Guid?" Value="ration.Id">@ration.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="Guid?" Label="GrowthTreatment" @bind-Value="context.GrowthTreatmentId">
                @foreach(var growthTreatment in _growthTreatments)
                {
                    <MudSelectItem T="Guid?" Value="growthTreatment.Id">@growthTreatment.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="Guid?" Label="PreventiveTreatment" @bind-Value="context.PreventiveTreatmentId">
                @foreach(var preventiveTreatment in _preventiveTreatments)
                {
                    <MudSelectItem T="Guid?" Value="preventiveTreatment.Id">@preventiveTreatment.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        @* TODO END *@
    </EditFormContent>

</EntityTable>