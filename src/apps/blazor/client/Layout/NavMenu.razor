<PersonCard Style="background-color: var(--mud-palette-drawer-background);color: var(--mud-palette-drawer-text); margin-bottom:0px!important" />
<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">Start</MudText>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    @* <MudNavLink Href="counter" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">Counter</MudNavLink> *@
    @if (_canViewAuditTrails)
    {
        <MudNavLink Match="NavLinkMatch.Prefix" Href="/identity/audit-trail" Icon="@Icons.Material.Filled.WorkHistory">Audit Trail</MudNavLink>
    } 
    <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">Modules</MudText>
    <MudNavGroup Title="Catalog" Icon="@Icons.Material.Filled.AddBox">
         <MudNavLink Href="/catalog/products" Icon="@Icons.Material.Filled.ShoppingBag" Class="fsh-nav-child">Products</MudNavLink>
        <MudNavLink Href="/catalog/brands" Icon="@Icons.Material.Filled.Label" Class="fsh-nav-child">Brands</MudNavLink>
    </MudNavGroup>
    <MudNavGroup Title="Ranch" Icon="@Icons.Material.Filled.AddBox">
        @if (_canViewRations)
        {
            <MudNavLink Href="/ranch/rations" Icon="@Icons.Material.Filled.Grass" Class="fsh-nav-child">Rations</MudNavLink>
        }
        @* Start MemberPage; *@        
        @if (_canViewMemberPages)
        {
            <MudNavLink Href="/ranch/memberPages" Icon="@Icons.Material.Filled.Groups" Class="fsh-nav-child">MemberPages</MudNavLink>
        }
        @* End MemberPage; *@
        @* Start ContractStatus; *@        
        @if (_canViewContractStatuses)
        {
            <MudNavLink Href="/ranch/contractStatuses" Icon="@Icons.Material.Filled.List" Class="fsh-nav-child">ContractStatuses</MudNavLink>
        }
        @* End ContractStatus; *@
        @* Start Contract; *@        
        @if (_canViewContracts)
        {
            <MudNavLink Href="/ranch/contracts" Icon="@Icons.Material.Filled.Handshake" Class="fsh-nav-child">Contracts</MudNavLink>
        }
        @* End Contract; *@
@* TODO ADD Ranch PAGES *@
    </MudNavGroup>
@* START Harvest NAV GROUP *@
    <MudNavGroup Title = "Harvest" Icon="@Icons.Material.Filled.AddBox">
        @* Start HarvestMember; *@        
        @if (_canViewHarvestMembers)
        {
            <MudNavLink Href="/ranch/harvestMembers" Icon="@Icons.Material.Filled.Groups" Class="fsh-nav-child">HarvestMembers</MudNavLink>
        }
        @* End HarvestMember; *@
        @* Start HarvestContractStatus; *@        
        @if (_canViewHarvestContractStatuses)
        {
            <MudNavLink Href="/ranch/harvestContractStatuses" Icon="@Icons.Material.Filled.List" Class="fsh-nav-child">HarvestContractStatuses</MudNavLink>
        }
        @* End HarvestContractStatus; *@
        @* Start HarvestContract; *@        
        @if (_canViewHarvestContracts)
        {
            <MudNavLink Href="/ranch/harvestContracts" Icon="@Icons.Material.Filled.Handshake" Class="fsh-nav-child">HarvestContracts</MudNavLink>
        }
        @* End HarvestContract; *@
@* TODO ADD Harvest PAGES *@
    </MudNavGroup>
@* END Harvest NAV GROUP *@
@* TODO ADD NEW MODULE *@
@*     <MudNavLink Href="/todos" Icon="@Icons.Material.Filled.Checklist" Class="fsh-nav-child">Todos</MudNavLink>  *@ 
   @if (CanViewAdministrationGroup)
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">Administration</MudText>
        @if (_canViewUsers)
        {
            <MudNavLink Match="NavLinkMatch.Prefix" Href="/identity/users" Icon="@Icons.Material.Filled.PeopleAlt">Users</MudNavLink>
        }
        @if (_canViewUserInvitations)
        {
            <MudNavLink Href="/invitations" Icon="@Icons.Material.Filled.Email">Invitations</MudNavLink>
        }
        @if (_canViewRoles)
        {
            <MudNavLink Href="/identity/roles" Icon="@Icons.Material.Filled.EmojiPeople">Roles</MudNavLink>
        }
        @if (_canViewTenants)
        {
            <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.GroupWork" Disabled="!_canViewTenants">Tenants</MudNavLink>
        }
        @if (_canManageAllUsers)
        {
            <MudNavLink Href="/admin/user-management" Icon="@Icons.Material.Filled.ManageAccounts">User Management</MudNavLink>
        }
    }
</MudNavMenu>
