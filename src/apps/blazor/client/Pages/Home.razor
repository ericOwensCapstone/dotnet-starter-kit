<style>
    .home-page-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Start with small WebP image for fast initial load */
    background-image: url('/cornfield-small.webp');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    z-index: -1;
    }
    
    /* Progressive enhancement for larger screens */
    @@media (min-width: 768px) {
        .home-page-container {
            background-image: url('/cornfield-medium.webp');
        }
    }
    
    @@media (min-width: 1024px) {
        .home-page-container {
            background-image: url('/cornfieldreduced.webp');
        }
    }
</style>

<div class="home-page-container"></div>

@if (_showAuthPanel)
{
    <div class="ohd-panel-wrapper" style="opacity: @(_opacity);" @ref="authPanelElement">
        <div class="ohd-panel-background"></div>
        <div class="ohd-panel-container">
            <div class="ohd-panel-content">
                <h1 class="ohd-panel-title">
                    OHD Harvest<br />
                    Marketplace
                </h1>
                <div class="ohd-panel-message">
                    Welcome back@(!string.IsNullOrEmpty(_userName) ? $" {_userName}" : "")!
                </div>
            </div>
        </div>
    </div>
}

